# ── Основное ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── База данных ───────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/energoatlant

# ── Секреты сессий и токенов (минимум 64 случайных символа) ─
# Генерация: openssl rand -hex 32
SESSION_SECRET=<64-символьная-строка-минимум>
MOBILE_TOKEN_SECRET=<64-символьная-строка-минимум>

# ── Yandex Object Storage (S3-совместимое) ────────────────
YOS_BUCKET=energoatlant-files
YOS_ENDPOINT=https://storage.yandexcloud.net
YOS_ACCESS_KEY=
YOS_SECRET_KEY=

# ── Google Gemini (AI-анализ смет) ────────────────────────
GEMINI_API_KEY=

# ── Почта (коды регистрации/восстановления + заявки с сайта) ─
# Один SMTP-аккаунт на всё (utils/email.js + contactController.js)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=energoatlant@yandex.ru
SMTP_PASS=

# ── SMS (SMS.ru — коды по телефону) ───────────────────────
# Если пусто — коды выводятся в консоль (dev), боевой код = 123456
SMSRU_API_ID=
